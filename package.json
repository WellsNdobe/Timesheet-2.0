{
  "name": "timesheet-2",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev:local",
    "dev:local": "npm run db:local:up && npm run db:migrate:local && concurrently \"npm run dev:web\" \"npm run dev:api:local\"",
    "dev:external": "concurrently \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "npm run dev --workspace=@timesheet/web",
    "dev:api": "npm run dev --workspace=@timesheet/api",
    "dev:api:local": "npm run dev:local --workspace=@timesheet/api",
    "db:local:up": "docker compose up -d --wait postgres",
    "db:local:down": "docker compose down",
    "db:generate": "npm run db:generate --workspace=@timesheet/api",
    "db:migrate": "npm run db:migrate --workspace=@timesheet/api",
    "db:migrate:local": "npm run db:migrate:local --workspace=@timesheet/api",
    "test:api": "npm run test --workspace=@timesheet/api",
    "test:web": "npm run test --workspace=@timesheet/web",
    "build": "npm run build --workspace=@timesheet/web",
    "typecheck": "npm run typecheck --workspace=@timesheet/web && npm run typecheck --workspace=@timesheet/api",
    "lint": "npm run lint --workspace=@timesheet/web",
    "lint:fix": "npm run lint:fix --workspace=@timesheet/web",
    "format": "npm run format --workspace=@timesheet/web",
    "format:check": "npm run format:check --workspace=@timesheet/web",
    "deploy:cloudflare": "npm run build --workspace=@timesheet/web && wrangler deploy"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "wrangler": "^4.123.0"
  }
}
